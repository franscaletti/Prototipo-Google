# Credenciales OAuth de Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application)
# Authorized JavaScript origin:  http://localhost:3000
# Authorized redirect URI:       http://localhost:3000/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails separados por coma que ingresan con rol "administrador".
# Cualquier otra cuenta de Google que loguee entra con rol "usuario".
GOOGLE_ADMIN_EMAILS=admin@gogrow.com

# Sólo para desarrollo local (docker compose). No usar este valor en producción.
SECRET_KEY_BASE=desarrollo_local_no_importa_el_valor
